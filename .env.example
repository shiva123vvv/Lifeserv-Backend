# 🌐 Database Configuration
DATABASE_URL=your_database_url_here

# 🔐 Security Configuration
JWT_SECRET=your_secret_here
JWT_EXPIRE=7d

# 🔥 Firebase Admin Configuration
# ─────────────────────────────────────────────────────────────
# Option A (Recommended for cloud): Granular env vars
FIREBASE_PROJECT_ID=lifeserv-22f27
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lifeserv-22f27.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option B (Easiest for cloud): Full service account as base64 or raw JSON
# Generate base64 from your service account JSON file:
#   macOS/Linux: base64 -i firebase-service-account.json
#   Windows:     certutil -encode firebase-service-account.json encoded.txt
# Then paste the single-line base64 string:
# FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLg==

# Option C (Development only): Local file path
# Place firebase-service-account.json in /backend (gitignored)
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# 🚀 Server Configuration
PORT=5001
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5001

# 💳 Razorpay (if applicable)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret